# Maintainer: chapdel <iamchapdel@gmail.com>
#
# Paquet AUR « -bin » (§41) : réempaquette l'archive tar.gz publiée par electron-builder.
# Avant publication : publier la release, mettre à jour pkgver et les sommes (updpkgsums).

pkgname=whathush-bin
_appid=io.github.chapdel.mcdesk
pkgver=0.2.0
pkgrel=1
pkgdesc="Several WhatsApp Web accounts side by side, with Snooze, Focus and deep sleep (not affiliated with WhatsApp or Meta)"
arch=('x86_64')
url="https://github.com/chapdel/whathush"
license=('LicenseRef-proprietary')
depends=('gtk3' 'libnotify' 'nss' 'libxss' 'libxtst' 'xdg-utils' 'at-spi2-core' 'util-linux-libs' 'libsecret' 'alsa-lib')
optdepends=('pipewire: screen sharing on Wayland'
            'xdg-desktop-portal: screen sharing picker'
            'libappindicator-gtk3: notification area icon'
            'kwallet: encrypted proxy credentials on KDE'
            'gnome-keyring: encrypted proxy credentials on GNOME')
provides=('whathush')
conflicts=('whathush')
options=('!strip' '!debug')
source=("whathush-${pkgver}.tar.gz::${url}/releases/download/v${pkgver}/whathush-${pkgver}.tar.gz"
        "${_appid}.desktop"
        "${_appid}.metainfo.xml"
        "${_appid}.png")
sha256sums=('b636fddda136f54572351be820269fddaec0255e51e5c6f5270ce21473fdeb30'
            '60f8a2a30515861d4e8822a668faf24269a5225a993dd8eee2d7bace41a1a791'
            '5d0c9d5b7375296184758f6df1104c03ae988b87976fd4fd2aed2cbac8d2ea04'
            '1cae46e4c22a84c4735cac999c458bb94ebb844a511ed410b16c26e4b08a81c7')

package() {
  install -d "${pkgdir}/opt/WhatHush"
  cp -a "whathush-${pkgver}/." "${pkgdir}/opt/WhatHush/"
  # Arch autorise les user namespaces : le bac à sable n'a pas besoin du bit SUID.
  chmod 755 "${pkgdir}/opt/WhatHush/chrome-sandbox"

  install -d "${pkgdir}/usr/bin"
  ln -s /opt/WhatHush/whathush "${pkgdir}/usr/bin/whathush"

  install -Dm644 "${_appid}.desktop" "${pkgdir}/usr/share/applications/${_appid}.desktop"
  install -Dm644 "${_appid}.metainfo.xml" "${pkgdir}/usr/share/metainfo/${_appid}.metainfo.xml"
  install -Dm644 "${_appid}.png" "${pkgdir}/usr/share/icons/hicolor/512x512/apps/${_appid}.png"
}
