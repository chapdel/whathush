{
  "name": "whathush",
  "version": "0.2.0",
  "private": true,
  "description": "Client desktop Linux multi-comptes pour WhatsApp Web (projet indépendant, non affilié à WhatsApp LLC ni à Meta Platforms)",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "npm run build && electron .",
    "typecheck": "tsc -p . --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && playwright test",
    "icons": "node scripts/icons.mjs",
    "dist": "npm run build && electron-builder --linux AppImage deb",
    "dist:all": "npm run build && electron-builder --linux AppImage deb rpm pacman tar.gz",
    "test:native": "npm run build && node tests/native/run.mjs",
    "demo": "npm run build && node scripts/fake-whatsapp.mjs"
  },
  "devDependencies": {
    "@electron/fuses": "2.1.3",
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "electron": "44.5.1",
    "electron-builder": "26.15.3",
    "electron-updater": "6.8.9",
    "esbuild": "0.28.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "7.0.2",
    "vite": "8.3.2",
    "vitest": "5.0.3",
    "zod": "4.6.5"
  },
  "productName": "WhatHush",
  "main": "dist/main/index.cjs",
  "desktopName": "io.github.chapdel.mcdesk.desktop",
  "homepage": "https://github.com/chapdel/whathush",
  "license": "UNLICENSED",
  "author": {
    "name": "chapdel",
    "email": "iamchapdel@gmail.com"
  }
}
